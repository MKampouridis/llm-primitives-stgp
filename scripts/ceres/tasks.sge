#!/bin/bash
# One element of an SGE job array: runs tasks (SGE_TASK_ID - 1) x COUNT .. + COUNT - 1 of a
# campaign plan (results_dir/campaigns/<CAMPAIGN>/tasks.json). Submit from the repository folder:
#
#   mkdir -p logs
#   qsub -t 1-720 -tc 60 -v CAMPAIGN=wp2-calibration scripts/ceres/tasks.sge
#
# `python scripts/campaign_tasks.py status --campaign <name> [--count K]` prints the number of
# elements and this qsub line. CERES requires -tc: at most 60 elements of an array at once, and
# about 250 across all of a user's arrays (hpc.essex.ac.uk, Grid Engine page). Tasks are safe to
# repeat: finished runs are skipped, so a failed or stopped element is simply submitted again.
#
# No run-time limit: all.q has none, and its jobs may be suspended while the higher-priority
# queue is busy, which a wall-clock limit would count against them.
#$ -N lpstgp
#$ -S /bin/bash
#$ -q all.q
#$ -cwd
#$ -j y
#$ -o logs/
set -eo pipefail   # not -u: conda's own activation scripts use variables that may be unset
: "${CAMPAIGN:?give CAMPAIGN with qsub -v}"
case "${SGE_TASK_ID:-}" in ''|*[!0-9]*) echo "submit this as a job array (qsub -t ...)" >&2; exit 1 ;; esac
unset PYTHONPATH   # CERES sets one for its own Pythons; the environment's Python would load their packages
source "$HOME/miniforge3/etc/profile.d/conda.sh"
conda activate lpstgp
export LPSTGP_PATHS="${LPSTGP_PATHS:-$PWD/config/paths.ceres.toml}"
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 VECLIB_MAXIMUM_THREADS=1 NUMBA_NUM_THREADS=1
export NUMBA_CACHE_DIR="${TMPDIR:-/tmp}/numba-cache-$USER"   # compiled code kept on the node, not on NFS
COUNT="${COUNT:-1}"
INDEX=$(( (SGE_TASK_ID - 1) * COUNT ))
echo "$(date -u +%FT%TZ) $(hostname) $CAMPAIGN tasks $INDEX..$(( INDEX + COUNT - 1 ))"
python scripts/campaign_tasks.py run --campaign "$CAMPAIGN" --index "$INDEX" --count "$COUNT"
echo "$(date -u +%FT%TZ) done"
